# Copy to .env and adjust. All variables are prefixed with DSCAP_.

# Data source: "demo" (self-contained, no node) or "rpc" (real Bitcoin Core).
DSCAP_DATA_SOURCE=demo

# Comma-separated list of allowed frontend origins (CORS).
DSCAP_CORS_ORIGINS=http://localhost:5173

# --- Only needed when DSCAP_DATA_SOURCE=rpc ---
# Requires a fully-synced Bitcoin Core node with txindex=1 and server=1.
DSCAP_RPC_USER=
DSCAP_RPC_PASSWORD=
DSCAP_RPC_HOST=127.0.0.1
DSCAP_RPC_PORT=8332

# --- Demo tuning (optional) ---
DSCAP_DEMO_BLOCK_SECONDS=12
DSCAP_DEMO_MAX_CONFIRMATIONS=15
